<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ABU ADEM JEWELLERY — Boutique QR & Print Studio</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Luxury Editorial & Geometric Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- QR Code Matrix Generator (Supports strict Error Correction Level H) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>

  <!-- Client-side QR Decoder for Real-Time Optical Scan Verification -->
  <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serifDisplay: ['Cinzel', 'serif'],
            serifEditorial: ['Cormorant Garamond', 'serif'],
            sansClean: ['Montserrat', 'sans-serif'],
          },
          colors: {
            silverMist: '#E5E7EB',
            sterling: '#B8C0CC',
            champagne: '#C5A467',
            champagneDark: '#9E7E43',
            ivorySilk: '#FAF8F5',
            obsidian: '#0B0B0C',
          },
        },
      },
    };
  </script>

  <style>
    body {
      font-family: 'Montserrat', sans-serif;
      background-color: #F3F4F6;
      color: #111827;
    }

    /* Subtle architectural grid backdrop for the preview stage */
    .studio-stage {
      background-color: #ECEEF2;
      background-image:
        radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.9) 0%, rgba(232, 235, 240, 0.7) 100%),
        linear-gradient(to right, rgba(184, 192, 204, 0.18) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(184, 192, 204, 0.18) 1px, transparent 1px);
      background-size: 100% 100%, 24px 24px, 24px 24px;
    }

    /* Custom range slider styling */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 4px;
      border-radius: 999px;
      background: #D1D5DB;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #111827;
      border: 2px solid #C5A467;
      margin-top: -6px;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
      transition: transform 0.15s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.12);
    }

    /* Smooth preview card shadow */
    .luxury-card-shadow {
      box-shadow:
        0 25px 50px -12px rgba(11, 11, 12, 0.14),
        0 4px 16px -2px rgba(11, 11, 12, 0.06),
        0 0 0 1px rgba(184, 192, 204, 0.45);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-champagne/20">

  <!-- Top Luxury Atelier Header -->
  <header class="bg-white border-b border-gray-200/90 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-obsidian border border-champagne/60 flex items-center justify-center shadow-sm">
          <span class="font-serifDisplay text-champagne text-sm font-semibold tracking-wider">AA</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-serifDisplay text-sm sm:text-base font-semibold tracking-[0.18em] text-obsidian">
              ABU ADEM JEWELLERY
            </h1>
            <span class="hidden sm:inline-block text-[10px] uppercase tracking-[0.2em] px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 border border-gray-200">
              Print &amp; QR Atelier
            </span>
          </div>
          <p class="text-[11px] text-gray-500 tracking-wide">
            High-Precision Boutique Navigation QR &bull; ECC Level H (30% Redundancy)
          </p>
        </div>
      </div>

      <!-- Live Verification Status Pill -->
      <div id="headerVerifyBadge" class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium transition-all">
        <span id="headerVerifyDot" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="headerVerifyText">Verifying QR Matrix...</span>
      </div>
    </div>
  </header>

  <!-- Main Two-Column Studio Workspace -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">

      <!-- LEFT COLUMN: Controls & Optical Verification (5 cols) -->
      <div class="lg:col-span-5 space-y-5">

        <!-- 1. Boutique Logo Integration Card -->
        <section class="bg-white rounded-2xl border border-gray-200/90 p-5 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-obsidian text-champagne text-[10px] flex items-center justify-center font-serifDisplay">1</span>
              Boutique Logo Integration
            </h2>
            <span id="logoStatusPill" class="text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200">
              Awaiting Logo File
            </span>
          </div>

          <p class="text-xs text-gray-500 leading-relaxed mb-3.5">
            Your original logo (<code class="text-gray-700 bg-gray-100 px-1.5 py-0.5 rounded">1000159266.jpg</code>) is centered without altering its proportions, typography, or calligraphy inside a protective high-contrast frame.
          </p>

          <!-- Upload / Dropzone -->
          <label id="logoDropzone" for="logoFileInput" class="group relative flex items-center gap-3.5 p-3.5 rounded-xl border-2 border-dashed border-gray-300 hover:border-champagne bg-gray-50/70 hover:bg-ivorySilk transition-all cursor-pointer">
            <div id="logoThumbWrapper" class="w-14 h-14 rounded-lg bg-obsidian border border-champagne/50 flex items-center justify-center overflow-hidden shrink-0 shadow-inner">
              <img id="logoThumbPreview" src="" alt="Boutique Logo Preview" class="w-full h-full object-contain hidden" />
              <div id="logoThumbPlaceholder" class="text-center px-1">
                <span class="block font-serifDisplay text-champagne text-xs">LOGO</span>
                <span class="block text-[9px] text-gray-400">Upload</span>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold text-gray-900 group-hover:text-champagneDark transition-colors">
                Select or Drop Your Logo Image
              </p>
              <p id="logoFileName" class="text-[11px] text-gray-500 truncate mt-0.5">
                Click to load 1000159266.jpg (PNG, JPG, WebP, SVG)
              </p>
            </div>
            <span class="px-3 py-1.5 rounded-lg bg-white border border-gray-300 text-xs font-medium text-gray-700 group-hover:border-champagne group-hover:text-obsidian shadow-xs shrink-0">
              Browse
            </span>
            <input id="logoFileInput" type="file" accept="image/*" class="sr-only" />
          </label>

          <!-- Medallion Shape & Scale -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mt-4 pt-4 border-t border-gray-100">
            <div>
              <label class="block text-[11px] font-medium uppercase tracking-wider text-gray-500 mb-1.5">
                Center Frame Shape
              </label>
              <div class="grid grid-cols-2 gap-1.5 bg-gray-100 p-1 rounded-xl">
                <button type="button" data-shape="square" class="shape-btn py-1.5 px-2.5 rounded-lg text-xs font-medium bg-white text-obsidian shadow-xs transition-all">
                  Square
                </button>
                <button type="button" data-shape="circle" class="shape-btn py-1.5 px-2.5 rounded-lg text-xs font-medium text-gray-600 hover:text-obsidian transition-all">
                  Circular
                </button>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="logoScaleRange" class="text-[11px] font-medium uppercase tracking-wider text-gray-500">
                  Logo Footprint
                </label>
                <span id="logoScaleLabel" class="text-[11px] font-semibold text-obsidian">19%</span>
              </div>
              <input id="logoScaleRange" type="range" min="15" max="22" step="1" value="19" class="w-full" />
              <div class="flex justify-between text-[10px] text-gray-400 mt-1">
                <span>15% (Ultra-Safe)</span>
                <span>22% (Max Safe)</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. Print Layout & Visual Aesthetic -->
        <section class="bg-white rounded-2xl border border-gray-200/90 p-5 shadow-sm">
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-800 flex items-center gap-2 mb-3.5">
            <span class="w-5 h-5 rounded-full bg-obsidian text-champagne text-[10px] flex items-center justify-center font-serifDisplay">2</span>
            Print Format &amp; Aesthetic
          </h2>

          <!-- Layout Format Selector -->
          <div class="mb-4">
            <label class="block text-[11px] font-medium uppercase tracking-wider text-gray-500 mb-1.5">
              Print Application Preset
            </label>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" data-preset="display" class="preset-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 border-obsidian bg-ivorySilk/70 text-obsidian transition-all">
                <span class="text-xs font-semibold">Boutique Card</span>
                <span class="text-[10px] text-gray-500 mt-0.5">Counter &amp; Display</span>
              </button>
              <button type="button" data-preset="insert" class="preset-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-gray-200 hover:border-gray-300 bg-white text-gray-700 transition-all">
                <span class="text-xs font-semibold">Packaging Card</span>
                <span class="text-[10px] text-gray-500 mt-0.5">Box &amp; Business</span>
              </button>
              <button type="button" data-preset="emblem" class="preset-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-gray-200 hover:border-gray-300 bg-white text-gray-700 transition-all">
                <span class="text-xs font-semibold">QR Emblem</span>
                <span class="text-[10px] text-gray-500 mt-0.5">Sticker &amp; Tag</span>
              </button>
            </div>
          </div>

          <!-- Surface Paper & Module Geometry -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-4">
            <div>
              <label class="block text-[11px] font-medium uppercase tracking-wider text-gray-500 mb-1.5">
                Paper Surface Tone
              </label>
              <div class="grid grid-cols-2 gap-1.5 bg-gray-100 p-1 rounded-xl">
                <button type="button" data-surface="white" class="surface-btn py-1.5 px-2.5 rounded-lg text-xs font-medium bg-white text-obsidian shadow-xs flex items-center justify-center gap-1.5 transition-all">
                  <span class="w-3 h-3 rounded-full bg-white border border-gray-300"></span>
                  Pure White
                </button>
                <button type="button" data-surface="ivory" class="surface-btn py-1.5 px-2.5 rounded-lg text-xs font-medium text-gray-600 hover:text-obsidian flex items-center justify-center gap-1.5 transition-all">
                  <span class="w-3 h-3 rounded-full bg-[#FAF8F5] border border-champagne/60"></span>
                  Silk Ivory
                </button>
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-medium uppercase tracking-wider text-gray-500 mb-1.5">
                QR Module Precision
              </label>
              <div class="grid grid-cols-2 gap-1.5 bg-gray-100 p-1 rounded-xl">
                <button type="button" data-module="square" class="module-btn py-1.5 px-2.5 rounded-lg text-xs font-medium bg-white text-obsidian shadow-xs transition-all">
                  Crisp Square
                </button>
                <button type="button" data-module="rounded" class="module-btn py-1.5 px-2.5 rounded-lg text-xs font-medium text-gray-600 hover:text-obsidian transition-all">
                  Soft Bevel
                </button>
              </div>
            </div>
          </div>

          <!-- Editorial Copy Toggles -->
          <div class="pt-3.5 border-t border-gray-100 space-y-2.5">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-medium text-gray-800">Welcome Hospitality Line</p>
                <p class="text-[11px] text-gray-500 italic font-serifEditorial text-sm">"We look forward to welcoming you."</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input id="toggleWelcomeLine" type="checkbox" checked class="sr-only peer" />
                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-obsidian"></div>
              </label>
            </div>

            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-medium text-gray-800">Print Quiet-Zone &amp; Trim Guides</p>
                <p class="text-[11px] text-gray-500">Preview only (never included in exported files)</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input id="togglePrintGuides" type="checkbox" class="sr-only peer" />
                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-obsidian"></div>
              </label>
            </div>
          </div>
        </section>

        <!-- 3. Live Optical Decoder & Verification Console -->
        <section class="bg-white rounded-2xl border border-gray-200/90 p-5 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-obsidian text-champagne text-[10px] flex items-center justify-center font-serifDisplay">3</span>
              Live Scanner Verification
            </h2>
            <button id="retestDecodeBtn" type="button" class="text-[11px] font-semibold text-champagneDark hover:text-obsidian underline underline-offset-2 transition-colors">
              Re-Decode Canvas
            </button>
          </div>

          <div id="verifyResultBox" class="rounded-xl p-3.5 bg-emerald-50/80 border border-emerald-200/90 text-xs space-y-2">
            <div class="flex items-center justify-between">
              <span id="verifyStatusTitle" class="font-semibold text-emerald-900 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Optical Decode Passed — Exact Match
              </span>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-white text-emerald-800 border border-emerald-200">
                ECC-H
              </span>
            </div>

            <div class="bg-white/90 rounded-lg p-2.5 border border-emerald-200/70 font-mono text-[11px] text-gray-800 break-all">
              <span class="text-[10px] uppercase tracking-wider text-gray-400 block mb-0.5">Decoded Payload:</span>
              <span id="decodedUrlOutput">https://maps.app.goo.gl/NqJWCzNzFWCn1TJDA</span>
            </div>
          </div>
        </section>

      </div>

      <!-- RIGHT COLUMN: Museum Preview Stage & Print Export (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-5">

        <!-- Preview Stage Container -->
        <div class="studio-stage rounded-2xl border border-gray-200/90 p-5 sm:p-8 flex flex-col items-center justify-center min-h-[500px] relative overflow-hidden">
          <!-- Subtle Top-Left Technical Spec Tag -->
          <div class="w-full flex items-center justify-between text-[11px] text-gray-500 mb-4">
            <span id="dimensionsBadge" class="bg-white/85 backdrop-blur-xs px-2.5 py-1 rounded-md border border-gray-200/80 font-medium">
              Print Spec: 4.0&Prime; &times; 5.33&Prime; @ 300 DPI (1200 &times; 1600 px)
            </span>
            <span class="hidden sm:inline-block bg-white/85 backdrop-blur-xs px-2.5 py-1 rounded-md border border-gray-200/80">
              Quiet Zone: 4 Modules &bull; 100% Contrast
            </span>
          </div>

          <!-- High-Resolution Rendered Artwork Canvas -->
          <div class="my-auto flex items-center justify-center w-full">
            <canvas id="previewCanvas" class="max-w-full h-auto rounded-sm luxury-card-shadow transition-all duration-200" style="max-height: 540px;"></canvas>
          </div>

          <!-- Mobile / Smartphone Scan Tip -->
          <p class="mt-5 text-[11px] text-gray-500 text-center max-w-md">
            Tip: Point your iPhone or Android camera directly at the screen above to test instant Google Maps redirection before exporting.
          </p>
        </div>

        <!-- Print-Ready Export Action Bar -->
        <div class="bg-white rounded-2xl border border-gray-200/90 p-5 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-obsidian">
                Print-Ready Production Export
              </h3>
              <p class="text-xs text-gray-500 mt-0.5">
                Verified lossless files for business cards, jewelry boxes, stickers &amp; storefront plaques.
              </p>
            </div>

            <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 shrink-0">
              <button id="exportSvgBtn" type="button" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-gray-300 hover:border-obsidian bg-white hover:bg-gray-50 text-obsidian text-xs font-semibold tracking-wide transition-all cursor-pointer">
                <svg class="w-4 h-4 text-champagneDark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                </svg>
                Download Vector SVG
              </button>

              <button id="exportPngBtn" type="button" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-obsidian hover:bg-gray-800 text-white border border-champagne/40 text-xs font-semibold tracking-wide shadow-sm transition-all cursor-pointer">
                <svg class="w-4 h-4 text-champagne" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download 300 DPI PNG
              </button>
            </div>
          </div>

          <!-- Toast / Notification Banner -->
          <div id="exportFeedback" class="hidden mt-3.5 px-3.5 py-2 rounded-lg bg-gray-900 text-white text-xs flex items-center justify-between">
            <span id="exportFeedbackText">Export complete.</span>
            <span class="text-champagne font-mono text-[10px]">300 DPI VERIFIED</span>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script>
    /**
     * ABU ADEM JEWELLERY — Boutique QR Code & Print Studio
     * Encodes exact URL: https://maps.app.goo.gl/NqJWCzNzFWCn1TJDA
     * Uses Error Correction Level H (30% damage recovery) & live jsQR verification.
     */
    (function () {
      'use strict';

      // Exact target URL — never altered or shortened
      const TARGET_URL = 'https://maps.app.goo.gl/NqJWCzNzFWCn1TJDA';

      // Boutique Copy Constants
      const COPY = {
        brand: 'ABU ADEM JEWELLERY',
        title: 'VISIT OUR BOUTIQUE',
        subtitle: 'Scan to find us on Google Maps',
        welcome: 'We look forward to welcoming you.',
      };

      // Application State
      const state = {
        preset: 'display',       // 'display' | 'insert' | 'emblem'
        surface: 'white',        // 'white' (#FFFFFF) | 'ivory' (#FAF8F5)
        medallionShape: 'square',// 'square' | 'circle'
        moduleStyle: 'square',   // 'square' | 'rounded'
        logoScalePct: 19,        // 15% to 22% of QR matrix width
        showWelcome: true,
        showGuides: false,
        logoImage: null,         // HTMLImageElement of user's uploaded logo
        logoDataUrl: null,       // Data URL for SVG vector embedding
        logoFileName: '1000159266.jpg',
        qrMatrix: null,          // 2D boolean array generated at ECC Level H
        moduleCount: 0,
      };

      // DOM Elements
      const previewCanvas = document.getElementById('previewCanvas');
      const logoFileInput = document.getElementById('logoFileInput');
      const logoDropzone = document.getElementById('logoDropzone');
      const logoThumbPreview = document.getElementById('logoThumbPreview');
      const logoThumbPlaceholder = document.getElementById('logoThumbPlaceholder');
      const logoFileNameEl = document.getElementById('logoFileName');
      const logoStatusPill = document.getElementById('logoStatusPill');
      const logoScaleRange = document.getElementById('logoScaleRange');
      const logoScaleLabel = document.getElementById('logoScaleLabel');
      const toggleWelcomeLine = document.getElementById('toggleWelcomeLine');
      const togglePrintGuides = document.getElementById('togglePrintGuides');
      const dimensionsBadge = document.getElementById('dimensionsBadge');
      const exportPngBtn = document.getElementById('exportPngBtn');
      const exportSvgBtn = document.getElementById('exportSvgBtn');
      const exportFeedback = document.getElementById('exportFeedback');
      const exportFeedbackText = document.getElementById('exportFeedbackText');
      const retestDecodeBtn = document.getElementById('retestDecodeBtn');

      // Verification UI Elements
      const headerVerifyBadge = document.getElementById('headerVerifyBadge');
      const headerVerifyDot = document.getElementById('headerVerifyDot');
      const headerVerifyText = document.getElementById('headerVerifyText');
      const verifyResultBox = document.getElementById('verifyResultBox');
      const verifyStatusTitle = document.getElementById('verifyStatusTitle');
      const decodedUrlOutput = document.getElementById('decodedUrlOutput');

      /**
       * Generates the QR Code boolean matrix using Error Correction Level 'H'
       */
      function buildQrMatrix() {
        // TypeNumber 0 auto-selects the smallest version that holds the payload at Level H
        const qr = qrcode(0, 'H');
        qr.addData(TARGET_URL, 'Byte');
        qr.make();

        const count = qr.getModuleCount();
        const matrix = [];
        for (let r = 0; r < count; r++) {
          const row = [];
          for (let c = 0; c < count; c++) {
            row.push(qr.isDark(r, c));
          }
          matrix.push(row);
        }
        state.qrMatrix = matrix;
        state.moduleCount = count;
      }

      /**
       * Returns print-ready pixel dimensions (at 300 DPI) and layout metrics for the active preset
       */
      function getLayoutMetrics() {
        if (state.preset === 'emblem') {
          return {
            width: 1500,
            height: 1500,
            dpiLabel: '5.0" × 5.0" @ 300 DPI (1500 × 1500 px)',
            qrSize: 1140,
            qrX: 180,
            qrY: 180,
          };
        }
        if (state.preset === 'insert') {
          return {
            width: 1500,
            height: 1050, // 5" x 3.5" luxury packaging / business card insert
            dpiLabel: '5.0" × 3.5" @ 300 DPI (1500 × 1050 px)',
            qrSize: 680,
            qrX: 140,
            qrY: 185,
          };
        }
        // Default: 'display' — Boutique Counter / Storefront Plaque (4" x 5.33")
        return {
          width: 1200,
          height: 1600,
          dpiLabel: '4.0" × 5.33" @ 300 DPI (1200 × 1600 px)',
          qrSize: 800,
          qrX: 200,
          qrY: 430,
        };
      }

      /**
       * Checks if a module (r, c) belongs to one of the three 7x7 finder patterns (plus 1-module separator)
       */
      function isFinderZone(r, c, count) {
        const inTopLeft = r < 8 && c < 8;
        const inTopRight = r < 8 && c >= count - 8;
        const inBottomLeft = r >= count - 8 && c < 8;
        return inTopLeft || inTopRight || inBottomLeft;
      }

      /**
       * Checks if a module (r, c) falls beneath the central logo medallion
       */
      function isUnderMedallion(r, c, count, logoRatio) {
        const center = count / 2;
        // Add a 0.6-module clean breathing margin around the medallion
        const halfSpan = (count * logoRatio) / 2 + 0.55;
        if (state.medallionShape === 'circle') {
          const dx = c + 0.5 - center;
          const dy = r + 0.5 - center;
          return Math.sqrt(dx * dx + dy * dy) < halfSpan;
        }
        return Math.abs(c + 0.5 - center) < halfSpan && Math.abs(r + 0.5 - center) < halfSpan;
      }

      /**
       * Renders the full print-ready composition onto a target HTMLCanvasElement
       */
      function renderToCanvas(canvas, includeGuides = false) {
        const metrics = getLayoutMetrics();
        canvas.width = metrics.width;
        canvas.height = metrics.height;

        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        const bgColor = state.surface === 'ivory' ? '#FAF8F5' : '#FFFFFF';
        const obsidian = '#0B0B0C';
        const champagne = '#C5A467';
        const sterling = '#B8C0CC';
        const slateMuted = '#5A606A';

        // 1. Paper Surface Fill
        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, metrics.width, metrics.height);

        // 2. Architectural Silver & Champagne Double Hairline Frame (for Display & Insert presets)
        if (state.preset !== 'emblem') {
          const outerPad = 48;
          const innerPad = 62;

          // Outer brushed silver frame
          ctx.strokeStyle = sterling;
          ctx.lineWidth = 2;
          ctx.strokeRect(outerPad, outerPad, metrics.width - outerPad * 2, metrics.height - outerPad * 2);

          // Inner champagne-gold frame
          ctx.strokeStyle = champagne;
          ctx.lineWidth = 1.5;
          ctx.strokeRect(innerPad, innerPad, metrics.width - innerPad * 2, metrics.height - innerPad * 2);

          // Subtle corner diamond accents
          const corners = [
            [outerPad, outerPad],
            [metrics.width - outerPad, outerPad],
            [outerPad, metrics.height - outerPad],
            [metrics.width - outerPad, metrics.height - outerPad],
          ];
          ctx.fillStyle = champagne;
          corners.forEach(([cx, cy]) => {
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(Math.PI / 4);
            ctx.fillRect(-5, -5, 10, 10);
            ctx.restore();
          });
        }

        // 3. Typography Layout per Preset
        ctx.textBaseline = 'middle';

        if (state.preset === 'display') {
          // Top Brand Crest
          ctx.fillStyle = champagne;
          ctx.font = '600 22px "Montserrat", sans-serif';
          ctx.textAlign = 'center';
          drawTrackedText(ctx, COPY.brand, metrics.width / 2, 165, 7);

          // Delicate silver divider rule
          drawOrnamentalDivider(ctx, metrics.width / 2, 212, 220, sterling, champagne);

          // Main Title: VISIT OUR BOUTIQUE
          ctx.fillStyle = obsidian;
          ctx.font = '600 50px "Cinzel", serif';
          drawTrackedText(ctx, COPY.title, metrics.width / 2, 285, 6);

          // Subtitle: Scan to find us on Google Maps
          ctx.fillStyle = slateMuted;
          ctx.font = '400 25px "Montserrat", sans-serif';
          drawTrackedText(ctx, COPY.subtitle, metrics.width / 2, 355, 1.5);

          // Bottom Section below QR
          const bottomStartY = metrics.qrY + metrics.qrSize + 95;
          drawOrnamentalDivider(ctx, metrics.width / 2, bottomStartY, 180, sterling, champagne);

          if (state.showWelcome) {
            ctx.fillStyle = '#2C2F36';
            ctx.font = 'italic 500 34px "Cormorant Garamond", serif';
            ctx.textAlign = 'center';
            ctx.fillText(COPY.welcome, metrics.width / 2, bottomStartY + 68);
          }

          // Micro URL Caption at foot
          ctx.fillStyle = '#8C939E';
          ctx.font = '500 17px "Montserrat", sans-serif';
          drawTrackedText(ctx, 'GOOGLE MAPS  •  VERIFIED LOCATION', metrics.width / 2, metrics.height - 102, 3.5);

        } else if (state.preset === 'insert') {
          // Horizontal Luxury Packaging / Business Card Layout
          const rightCenterX = 1130;

          ctx.fillStyle = champagne;
          ctx.font = '600 18px "Montserrat", sans-serif';
          ctx.textAlign = 'center';
          drawTrackedText(ctx, COPY.brand, rightCenterX, 275, 5.5);

          drawOrnamentalDivider(ctx, rightCenterX, 320, 180, sterling, champagne);

          ctx.fillStyle = obsidian;
          ctx.font = '600 38px "Cinzel", serif';
          drawTrackedText(ctx, 'VISIT OUR', rightCenterX, 395, 5);
          drawTrackedText(ctx, 'BOUTIQUE', rightCenterX, 448, 5);

          ctx.fillStyle = slateMuted;
          ctx.font = '400 21px "Montserrat", sans-serif';
          drawTrackedText(ctx, COPY.subtitle, rightCenterX, 535, 1);

          if (state.showWelcome) {
            drawOrnamentalDivider(ctx, rightCenterX, 605, 140, sterling, champagne);
            ctx.fillStyle = '#2C2F36';
            ctx.font = 'italic 500 29px "Cormorant Garamond", serif';
            ctx.textAlign = 'center';
            ctx.fillText(COPY.welcome, rightCenterX, 665);
          }

          ctx.fillStyle = '#8C939E';
          ctx.font = '500 14px "Montserrat", sans-serif';
          drawTrackedText(ctx, 'SCAN WITH CAMERA', rightCenterX, 765, 3);
        }

        // 4. Render Precision QR Code Matrix (ECC Level H)
        const count = state.moduleCount;
        const cellSize = metrics.qrSize / count;
        const logoRatio = state.logoScalePct / 100;

        // Pure high-contrast QR backing plate (ensures 100% crisp scanner quiet zone)
        const quietZonePx = cellSize * 4;
        ctx.fillStyle = bgColor;
        ctx.fillRect(
          metrics.qrX - quietZonePx,
          metrics.qrY - quietZonePx,
          metrics.qrSize + quietZonePx * 2,
          metrics.qrSize + quietZonePx * 2
        );

        ctx.fillStyle = obsidian;
        for (let r = 0; r < count; r++) {
          for (let c = 0; c < count; c++) {
            if (!state.qrMatrix[r][c]) continue;
            // Keep center medallion zone clean so partial modules never peek behind the logo border
            if (isUnderMedallion(r, c, count, logoRatio)) continue;

            const x = metrics.qrX + c * cellSize;
            const y = metrics.qrY + r * cellSize;

            if (state.moduleStyle === 'rounded' && !isFinderZone(r, c, count)) {
              const pad = cellSize * 0.08;
              const size = cellSize - pad * 2;
              drawRoundedRect(ctx, x + pad, y + pad, size, size, size * 0.34);
              ctx.fill();
            } else {
              // Crisp overlap (+0.35px) prevents subpixel anti-aliasing seams on high-res rasterization
              ctx.fillRect(x, y, cellSize + 0.35, cellSize + 0.35);
            }
          }
        }

        // 5. Render Centered Boutique Logo Medallion (Unmodified Aspect Ratio)
        const centerX = metrics.qrX + metrics.qrSize / 2;
        const centerY = metrics.qrY + metrics.qrSize / 2;
        const medallionSize = metrics.qrSize * logoRatio;
        const halfMed = medallionSize / 2;

        ctx.save();
        if (state.medallionShape === 'circle') {
          // Clean protective circular background
          ctx.beginPath();
          ctx.arc(centerX, centerY, halfMed, 0, Math.PI * 2);
          ctx.fillStyle = bgColor;
          ctx.fill();

          // Outer sterling silver hairline
          ctx.lineWidth = 2.5;
          ctx.strokeStyle = sterling;
          ctx.stroke();

          // Inner champagne gold hairline
          ctx.beginPath();
          ctx.arc(centerX, centerY, halfMed - 6, 0, Math.PI * 2);
          ctx.lineWidth = 2;
          ctx.strokeStyle = champagne;
          ctx.stroke();

          // Clip inner logo area cleanly
          ctx.beginPath();
          ctx.arc(centerX, centerY, halfMed - 10, 0, Math.PI * 2);
          ctx.clip();
        } else {
          // Clean protective rounded-square background
          const cornerRadius = 14;
          drawRoundedRect(ctx, centerX - halfMed, centerY - halfMed, medallionSize, medallionSize, cornerRadius);
          ctx.fillStyle = bgColor;
          ctx.fill();

          // Outer sterling silver hairline
          ctx.lineWidth = 2.5;
          ctx.strokeStyle = sterling;
          ctx.stroke();

          // Inner champagne gold hairline
          drawRoundedRect(
            ctx,
            centerX - halfMed + 6,
            centerY - halfMed + 6,
            medallionSize - 12,
            medallionSize - 12,
            Math.max(6, cornerRadius - 4)
          );
          ctx.lineWidth = 2;
          ctx.strokeStyle = champagne;
          ctx.stroke();

          // Clip inner logo area cleanly
          drawRoundedRect(
            ctx,
            centerX - halfMed + 10,
            centerY - halfMed + 10,
            medallionSize - 20,
            medallionSize - 20,
            Math.max(4, cornerRadius - 6)
          );
          ctx.clip();
        }

        const innerBoxSize = medallionSize - 20;
        if (state.logoImage) {
          // Preserve exact original proportions & orientation without any distortion
          const imgW = state.logoImage.naturalWidth || state.logoImage.width;
          const imgH = state.logoImage.naturalHeight || state.logoImage.height;
          const scale = Math.min(innerBoxSize / imgW, innerBoxSize / imgH);
          const drawW = imgW * scale;
          const drawH = imgH * scale;
          ctx.drawImage(
            state.logoImage,
            centerX - drawW / 2,
            centerY - drawH / 2,
            drawW,
            drawH
          );
        } else {
          // Refined placeholder crest until user selects 1000159266.jpg
          ctx.fillStyle = obsidian;
          ctx.fillRect(centerX - innerBoxSize / 2, centerY - innerBoxSize / 2, innerBoxSize, innerBoxSize);
          ctx.fillStyle = champagne;
          ctx.font = `600 ${Math.round(innerBoxSize * 0.22)}px "Cinzel", serif`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('ABU ADEM', centerX, centerY - innerBoxSize * 0.08);
          ctx.font = `500 ${Math.round(innerBoxSize * 0.11)}px "Montserrat", sans-serif`;
          ctx.fillStyle = '#E5D3B3';
          ctx.fillText('JEWELLERY', centerX, centerY + innerBoxSize * 0.14);
        }
        ctx.restore();

        // 6. Optional Print-Preview Guides (Never rendered in exports)
        if (includeGuides) {
          ctx.save();
          ctx.setLineDash([8, 6]);
          ctx.lineWidth = 2;
          ctx.strokeStyle = 'rgba(16, 185, 129, 0.75)';
          ctx.strokeRect(
            metrics.qrX - quietZonePx,
            metrics.qrY - quietZonePx,
            metrics.qrSize + quietZonePx * 2,
            metrics.qrSize + quietZonePx * 2
          );
          ctx.restore();
        }
      }

      /**
       * Helper: Draws letter-spaced centered text on HTML5 Canvas
       */
      function drawTrackedText(ctx, text, centerX, y, letterSpacing) {
        const chars = Array.from(text);
        let totalWidth = 0;
        chars.forEach((ch, idx) => {
          totalWidth += ctx.measureText(ch).width + (idx < chars.length - 1 ? letterSpacing : 0);
        });
        let cursorX = centerX - totalWidth / 2;
        ctx.textAlign = 'left';
        chars.forEach((ch) => {
          ctx.fillText(ch, cursorX, y);
          cursorX += ctx.measureText(ch).width + letterSpacing;
        });
        ctx.textAlign = 'center';
      }

      /**
       * Helper: Draws an understated luxury silver hairline with a centered champagne diamond
       */
      function drawOrnamentalDivider(ctx, cx, cy, width, silverColor, goldColor) {
        const half = width / 2;
        ctx.strokeStyle = silverColor;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(cx - half, cy);
        ctx.lineTo(cx - 14, cy);
        ctx.moveTo(cx + 14, cy);
        ctx.lineTo(cx + half, cy);
        ctx.stroke();

        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(Math.PI / 4);
        ctx.fillStyle = goldColor;
        ctx.fillRect(-4.5, -4.5, 9, 9);
        ctx.restore();
      }

      /**
       * Helper: Draws a rounded rectangle path
       */
      function drawRoundedRect(ctx, x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.lineTo(x + w - r, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + r);
        ctx.lineTo(x + w, y + h - r);
        ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
        ctx.lineTo(x + r, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - r);
        ctx.lineTo(x, y + r);
        ctx.quadraticCurveTo(x, y, x + r, y);
        ctx.closePath();
      }

      /**
       * Runs real optical QR decoding via jsQR directly on the rendered canvas pixels
       * to guarantee 100% genuine scannability and exact URL accuracy.
       */
      function verifyRenderedCanvas(canvas) {
        try {
          const ctx = canvas.getContext('2d', { willReadFrequently: true });
          const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const decoded = jsQR(imageData.data, imageData.width, imageData.height, {
            inversionAttempts: 'dontInvert',
          });

          if (decoded && decoded.data === TARGET_URL) {
            setVerificationUI(true, decoded.data);
            return true;
          } else {
            setVerificationUI(false, decoded ? decoded.data : 'Unable to decode — reduce logo size');
            return false;
          }
        } catch (err) {
          console.error('QR Verification error:', err);
          setVerificationUI(false, 'Verification error');
          return false;
        }
      }

      /**
       * Updates both the top status pill and the verification console card
       */
      function setVerificationUI(isValid, payloadText) {
        decodedUrlOutput.textContent = payloadText;

        if (isValid) {
          headerVerifyBadge.className = 'flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium transition-all';
          headerVerifyDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
          headerVerifyText.textContent = 'Verified Scannable • Exact URL Match';

          verifyResultBox.className = 'rounded-xl p-3.5 bg-emerald-50/80 border border-emerald-200/90 text-xs space-y-2';
          verifyStatusTitle.className = 'font-semibold text-emerald-900 flex items-center gap-1.5';
          verifyStatusTitle.innerHTML = `
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Optical Decode Passed — Exact Match
          `;
        } else {
          headerVerifyBadge.className = 'flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium transition-all';
          headerVerifyDot.className = 'w-2 h-2 rounded-full bg-rose-500';
          headerVerifyText.textContent = 'Scan Warning — Adjust Logo Scale';

          verifyResultBox.className = 'rounded-xl p-3.5 bg-rose-50/80 border border-rose-200/90 text-xs space-y-2';
          verifyStatusTitle.className = 'font-semibold text-rose-900 flex items-center gap-1.5';
          verifyStatusTitle.textContent = 'Optical Decode Warning — Reduce Logo Footprint';
        }
      }

      /**
       * Master render + live optical verification cycle
       */
      function updateStudio() {
        const metrics = getLayoutMetrics();
        dimensionsBadge.textContent = `Print Spec: ${metrics.dpiLabel}`;
        renderToCanvas(previewCanvas, state.showGuides);
        verifyRenderedCanvas(previewCanvas);
      }

      /**
       * Injects a true 300 DPI (11,811 pixels per meter) pHYs chunk into a PNG DataURL
       * so professional print software (Illustrator, Photoshop, InDesign) opens it at exact 300 DPI.
       */
      function inject300DpiPngMetadata(dataUrl) {
        const base64 = dataUrl.split(',')[1];
        const binary = atob(base64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
          bytes[i] = binary.charCodeAt(i);
        }

        // 300 DPI = 11811 pixels per meter (0x00002E23)
        const pHYsChunk = new Uint8Array([
          0x00, 0x00, 0x00, 0x09, // Length: 9 bytes
          0x70, 0x48, 0x59, 0x73, // Type: "pHYs"
          0x00, 0x00, 0x2E, 0x23, // X pixels per unit: 11811
          0x00, 0x00, 0x2E, 0x23, // Y pixels per unit: 11811
          0x01,                   // Unit specifier: 1 (meter)
          0x00, 0x00, 0x00, 0x00  // CRC placeholder
        ]);

        // Compute CRC32 over Type + Data (bytes 4..16)
        const crc = crc32(pHYsChunk.subarray(4, 17));
        pHYsChunk[17] = (crc >>> 24) & 0xff;
        pHYsChunk[18] = (crc >>> 16) & 0xff;
        pHYsChunk[19] = (crc >>> 8) & 0xff;
        pHYsChunk[20] = crc & 0xff;

        // Insert right after the 8-byte PNG signature + 25-byte IHDR chunk (offset 33)
        const output = new Uint8Array(bytes.length + pHYsChunk.length);
        output.set(bytes.subarray(0, 33), 0);
        output.set(pHYsChunk, 33);
        output.set(bytes.subarray(33), 33 + pHYsChunk.length);

        return new Blob([output], { type: 'image/png' });
      }

      /**
       * Standard CRC-32 calculation for PNG chunk integrity
       */
      function crc32(buf) {
        let c = 0xffffffff;
        for (let i = 0; i < buf.length; i++) {
          c ^= buf[i];
          for (let k = 0; k < 8; k++) {
            c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
          }
        }
        return (c ^ 0xffffffff) >>> 0;
      }

      /**
       * Exports a true 300 DPI print-ready PNG file after verifying scan accuracy
       */
      function exportHighResPng() {
        const exportCanvas = document.createElement('canvas');
        renderToCanvas(exportCanvas, false); // Always exclude preview guides

        const passed = verifyRenderedCanvas(exportCanvas);
        if (!passed) {
          showFeedback('Warning: Reduce logo scale slightly before printing to ensure 100% scan reliability.');
          return;
        }

        const rawDataUrl = exportCanvas.toDataURL('image/png', 1.0);
        const png300DpiBlob = inject300DpiPngMetadata(rawDataUrl);
        const fileName = `ABU-ADEM-JEWELLERY-QR-${state.preset.toUpperCase()}-300DPI.png`;

        triggerBlobDownload(png300DpiBlob, fileName);
        showFeedback(`Exported ${fileName} (Verified Scannable • 300 DPI)`);
      }

      /**
       * Generates and downloads a true scalable Vector SVG file for print & Adobe Illustrator
       */
      function exportVectorSvg() {
        const metrics = getLayoutMetrics();
        const bgColor = state.surface === 'ivory' ? '#FAF8F5' : '#FFFFFF';
        const obsidian = '#0B0B0C';
        const champagne = '#C5A467';
        const sterling = '#B8C0CC';
        const slateMuted = '#5A606A';

        const count = state.moduleCount;
        const cellSize = metrics.qrSize / count;
        const logoRatio = state.logoScalePct / 100;
        const centerX = metrics.qrX + metrics.qrSize / 2;
        const centerY = metrics.qrY + metrics.qrSize / 2;
        const medallionSize = metrics.qrSize * logoRatio;
        const halfMed = medallionSize / 2;

        let svgParts = [];
        svgParts.push(`<?xml version="1.0" encoding="UTF-8"?>`);
        svgParts.push(`<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="${metrics.width}" height="${metrics.height}" viewBox="0 0 ${metrics.width} ${metrics.height}">`);
        svgParts.push(`  <title>${COPY.brand} — Google Maps QR Code</title>`);
        svgParts.push(`  <desc>Encoded URL: ${TARGET_URL} | Error Correction Level H</desc>`);

        // Clip paths for central medallion
        svgParts.push(`  <defs>`);
        if (state.medallionShape === 'circle') {
          svgParts.push(`    <clipPath id="logoClip"><circle cx="${centerX}" cy="${centerY}" r="${halfMed - 10}" /></clipPath>`);
        } else {
          svgParts.push(`    <clipPath id="logoClip"><rect x="${centerX - halfMed + 10}" y="${centerY - halfMed + 10}" width="${medallionSize - 20}" height="${medallionSize - 20}" rx="8" ry="8" /></clipPath>`);
        }
        svgParts.push(`  </defs>`);

        // Paper background
        svgParts.push(`  <rect x="0" y="0" width="${metrics.width}" height="${metrics.height}" fill="${bgColor}" />`);

        // Decorative silver & champagne double borders + typography
        if (state.preset !== 'emblem') {
          const outerPad = 48;
          const innerPad = 62;
          svgParts.push(`  <rect x="${outerPad}" y="${outerPad}" width="${metrics.width - outerPad * 2}" height="${metrics.height - outerPad * 2}" fill="none" stroke="${sterling}" stroke-width="2" />`);
          svgParts.push(`  <rect x="${innerPad}" y="${innerPad}" width="${metrics.width - innerPad * 2}" height="${metrics.height - innerPad * 2}" fill="none" stroke="${champagne}" stroke-width="1.5" />`);
        }

        if (state.preset === 'display') {
          svgParts.push(`  <text x="${metrics.width / 2}" y="165" text-anchor="middle" dominant-baseline="middle" fill="${champagne}" font-family="Montserrat, sans-serif" font-size="22" font-weight="600" letter-spacing="7">${COPY.brand}</text>`);
          svgParts.push(`  <line x1="${metrics.width / 2 - 110}" y1="212" x2="${metrics.width / 2 - 14}" y2="212" stroke="${sterling}" stroke-width="1.5" />`);
          svgParts.push(`  <line x1="${metrics.width / 2 + 14}" y1="212" x2="${metrics.width / 2 + 110}" y2="212" stroke="${sterling}" stroke-width="1.5" />`);
          svgParts.push(`  <rect x="${metrics.width / 2 - 4.5}" y="207.5" width="9" height="9" fill="${champagne}" transform="rotate(45 ${metrics.width / 2} 212)" />`);

          svgParts.push(`  <text x="${metrics.width / 2}" y="285" text-anchor="middle" dominant-baseline="middle" fill="${obsidian}" font-family="Cinzel, serif" font-size="50" font-weight="600" letter-spacing="6">${COPY.title}</text>`);
          svgParts.push(`  <text x="${metrics.width / 2}" y="355" text-anchor="middle" dominant-baseline="middle" fill="${slateMuted}" font-family="Montserrat, sans-serif" font-size="25" font-weight="400" letter-spacing="1.5">${COPY.subtitle}</text>`);

          const bottomStartY = metrics.qrY + metrics.qrSize + 95;
          svgParts.push(`  <line x1="${metrics.width / 2 - 90}" y1="${bottomStartY}" x2="${metrics.width / 2 - 14}" y2="${bottomStartY}" stroke="${sterling}" stroke-width="1.5" />`);
          svgParts.push(`  <line x1="${metrics.width / 2 + 14}" y1="${bottomStartY}" x2="${metrics.width / 2 + 90}" y2="${bottomStartY}" stroke="${sterling}" stroke-width="1.5" />`);
          svgParts.push(`  <rect x="${metrics.width / 2 - 4.5}" y="${bottomStartY - 4.5}" width="9" height="9" fill="${champagne}" transform="rotate(45 ${metrics.width / 2} ${bottomStartY})" />`);

          if (state.showWelcome) {
            svgParts.push(`  <text x="${metrics.width / 2}" y="${bottomStartY + 68}" text-anchor="middle" dominant-baseline="middle" fill="#2C2F36" font-family="Cormorant Garamond, serif" font-style="italic" font-size="34" font-weight="500">${COPY.welcome}</text>`);
          }
          svgParts.push(`  <text x="${metrics.width / 2}" y="${metrics.height - 102}" text-anchor="middle" dominant-baseline="middle" fill="#8C939E" font-family="Montserrat, sans-serif" font-size="17" font-weight="500" letter-spacing="3.5">GOOGLE MAPS  •  VERIFIED LOCATION</text>`);
        } else if (state.preset === 'insert') {
          const rightCenterX = 1130;
          svgParts.push(`  <text x="${rightCenterX}" y="275" text-anchor="middle" dominant-baseline="middle" fill="${champagne}" font-family="Montserrat, sans-serif" font-size="18" font-weight="600" letter-spacing="5.5">${COPY.brand}</text>`);
          svgParts.push(`  <line x1="${rightCenterX - 90}" y1="320" x2="${rightCenterX - 14}" y2="320" stroke="${sterling}" stroke-width="1.5" />`);
          svgParts.push(`  <line x1="${rightCenterX + 14}" y1="320" x2="${rightCenterX + 90}" y2="320" stroke="${sterling}" stroke-width="1.5" />`);
          svgParts.push(`  <rect x="${rightCenterX - 4.5}" y="315.5" width="9" height="9" fill="${champagne}" transform="rotate(45 ${rightCenterX} 320)" />`);

          svgParts.push(`  <text x="${rightCenterX}" y="395" text-anchor="middle" dominant-baseline="middle" fill="${obsidian}" font-family="Cinzel, serif" font-size="38" font-weight="600" letter-spacing="5">VISIT OUR</text>`);
          svgParts.push(`  <text x="${rightCenterX}" y="448" text-anchor="middle" dominant-baseline="middle" fill="${obsidian}" font-family="Cinzel, serif" font-size="38" font-weight="600" letter-spacing="5">BOUTIQUE</text>`);
          svgParts.push(`  <text x="${rightCenterX}" y="535" text-anchor="middle" dominant-baseline="middle" fill="${slateMuted}" font-family="Montserrat, sans-serif" font-size="21" font-weight="400" letter-spacing="1">${COPY.subtitle}</text>`);

          if (state.showWelcome) {
            svgParts.push(`  <line x1="${rightCenterX - 70}" y1="605" x2="${rightCenterX - 14}" y2="605" stroke="${sterling}" stroke-width="1.5" />`);
            svgParts.push(`  <line x1="${rightCenterX + 14}" y1="605" x2="${rightCenterX + 70}" y2="605" stroke="${sterling}" stroke-width="1.5" />`);
            svgParts.push(`  <rect x="${rightCenterX - 4.5}" y="600.5" width="9" height="9" fill="${champagne}" transform="rotate(45 ${rightCenterX} 605)" />`);
            svgParts.push(`  <text x="${rightCenterX}" y="665" text-anchor="middle" dominant-baseline="middle" fill="#2C2F36" font-family="Cormorant Garamond, serif" font-style="italic" font-size="29" font-weight="500">${COPY.welcome}</text>`);
          }
          svgParts.push(`  <text x="${rightCenterX}" y="765" text-anchor="middle" dominant-baseline="middle" fill="#8C939E" font-family="Montserrat, sans-serif" font-size="14" font-weight="500" letter-spacing="3">SCAN WITH CAMERA</text>`);
        }

        // Vector QR Modules
        svgParts.push(`  <g id="qr-modules" fill="${obsidian}">`);
        for (let r = 0; r < count; r++) {
          for (let c = 0; c < count; c++) {
            if (!state.qrMatrix[r][c]) continue;
            if (isUnderMedallion(r, c, count, logoRatio)) continue;

            const x = (metrics.qrX + c * cellSize).toFixed(2);
            const y = (metrics.qrY + r * cellSize).toFixed(2);
            const w = (cellSize + 0.15).toFixed(2);

            if (state.moduleStyle === 'rounded' && !isFinderZone(r, c, count)) {
              const pad = cellSize * 0.08;
              const size = cellSize - pad * 2;
              const rad = (size * 0.34).toFixed(2);
              svgParts.push(`    <rect x="${(metrics.qrX + c * cellSize + pad).toFixed(2)}" y="${(metrics.qrY + r * cellSize + pad).toFixed(2)}" width="${size.toFixed(2)}" height="${size.toFixed(2)}" rx="${rad}" ry="${rad}" />`);
            } else {
              svgParts.push(`    <rect x="${x}" y="${y}" width="${w}" height="${w}" />`);
            }
          }
        }
        svgParts.push(`  </g>`);

        // Central Medallion Frame + Embedded Unmodified Logo
        if (state.medallionShape === 'circle') {
          svgParts.push(`  <circle cx="${centerX}" cy="${centerY}" r="${halfMed}" fill="${bgColor}" stroke="${sterling}" stroke-width="2.5" />`);
          svgParts.push(`  <circle cx="${centerX}" cy="${centerY}" r="${halfMed - 6}" fill="none" stroke="${champagne}" stroke-width="2" />`);
        } else {
          svgParts.push(`  <rect x="${centerX - halfMed}" y="${centerY - halfMed}" width="${medallionSize}" height="${medallionSize}" rx="14" ry="14" fill="${bgColor}" stroke="${sterling}" stroke-width="2.5" />`);
          svgParts.push(`  <rect x="${centerX - halfMed + 6}" y="${centerY - halfMed + 6}" width="${medallionSize - 12}" height="${medallionSize - 12}" rx="10" ry="10" fill="none" stroke="${champagne}" stroke-width="2" />`);
        }

        const innerBoxSize = medallionSize - 20;
        if (state.logoDataUrl) {
          svgParts.push(`  <image x="${centerX - innerBoxSize / 2}" y="${centerY - innerBoxSize / 2}" width="${innerBoxSize}" height="${innerBoxSize}" preserveAspectRatio="xMidYMid meet" clip-path="url(#logoClip)" href="${state.logoDataUrl}" xlink:href="${state.logoDataUrl}" />`);
        } else {
          svgParts.push(`  <g clip-path="url(#logoClip)">`);
          svgParts.push(`    <rect x="${centerX - innerBoxSize / 2}" y="${centerY - innerBoxSize / 2}" width="${innerBoxSize}" height="${innerBoxSize}" fill="${obsidian}" />`);
          svgParts.push(`    <text x="${centerX}" y="${centerY - innerBoxSize * 0.08}" text-anchor="middle" dominant-baseline="middle" fill="${champagne}" font-family="Cinzel, serif" font-size="${Math.round(innerBoxSize * 0.22)}" font-weight="600">ABU ADEM</text>`);
          svgParts.push(`    <text x="${centerX}" y="${centerY + innerBoxSize * 0.14}" text-anchor="middle" dominant-baseline="middle" fill="#E5D3B3" font-family="Montserrat, sans-serif" font-size="${Math.round(innerBoxSize * 0.11)}" font-weight="500">JEWELLERY</text>`);
          svgParts.push(`  </g>`);
        }

        svgParts.push(`</svg>`);

        const svgBlob = new Blob([svgParts.join('\n')], { type: 'image/svg+xml;charset=utf-8' });
        const fileName = `ABU-ADEM-JEWELLERY-QR-${state.preset.toUpperCase()}-VECTOR.svg`;
        triggerBlobDownload(svgBlob, fileName);
        showFeedback(`Exported ${fileName} (True Scalable Vector SVG)`);
      }

      /**
       * Helper: Triggers browser download from a Blob
       */
      function triggerBlobDownload(blob, filename) {
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => URL.revokeObjectURL(url), 1500);
      }

      /**
       * Shows brief non-intrusive feedback banner after export
       */
      function showFeedback(message) {
        exportFeedbackText.textContent = message;
        exportFeedback.classList.remove('hidden');
        clearTimeout(showFeedback._timer);
        showFeedback._timer = setTimeout(() => {
          exportFeedback.classList.add('hidden');
        }, 4500);
      }

      /**
       * Loads user-selected logo file without altering proportions or colors
       */
      function handleLogoFile(file) {
        if (!file || !file.type.startsWith('image/')) return;

        const reader = new FileReader();
        reader.onload = function (e) {
          const dataUrl = e.target.result;
          const img = new Image();
          img.onload = function () {
            state.logoImage = img;
            state.logoDataUrl = dataUrl;
            state.logoFileName = file.name;

            // Update thumbnail & status UI
            logoThumbPreview.src = dataUrl;
            logoThumbPreview.classList.remove('hidden');
            logoThumbPlaceholder.classList.add('hidden');
            logoFileNameEl.textContent = `${file.name} (${img.naturalWidth}×${img.naturalHeight}px)`;

            logoStatusPill.textContent = 'Original Logo Active';
            logoStatusPill.className = 'text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200';

            updateStudio();
          };
          img.src = dataUrl;
        };
        reader.readAsDataURL(file);
      }

      /**
       * Attempts to preload 1000159266.jpg if co-located in the environment
       */
      function tryPreloadUploadedLogo() {
        const probe = new Image();
        probe.onload = function () {
          // Convert to DataURL so SVG vector export can also embed it cleanly
          const tmpCanvas = document.createElement('canvas');
          tmpCanvas.width = probe.naturalWidth;
          tmpCanvas.height = probe.naturalHeight;
          tmpCanvas.getContext('2d').drawImage(probe, 0, 0);
          try {
            state.logoDataUrl = tmpCanvas.toDataURL('image/png');
          } catch (_) {
            state.logoDataUrl = '1000159266.jpg';
          }
          state.logoImage = probe;

          logoThumbPreview.src = probe.src;
          logoThumbPreview.classList.remove('hidden');
          logoThumbPlaceholder.classList.add('hidden');
          logoFileNameEl.textContent = `1000159266.jpg (${probe.naturalWidth}×${probe.naturalHeight}px)`;
          logoStatusPill.textContent = 'Original Logo Loaded';
          logoStatusPill.className = 'text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200';

          updateStudio();
        };
        probe.onerror = function () {
          // Remain ready for instant 1-click upload via the dropzone
        };
        probe.src = '1000159266.jpg';
      }

      // Wire Interactive Controls
      logoFileInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          handleLogoFile(e.target.files[0]);
        }
      });

      // Drag-and-drop support on logo dropzone
      ['dragenter', 'dragover'].forEach((evtName) => {
        logoDropzone.addEventListener(evtName, (e) => {
          e.preventDefault();
          logoDropzone.classList.add('border-champagne', 'bg-ivorySilk');
        });
      });
      ['dragleave', 'drop'].forEach((evtName) => {
        logoDropzone.addEventListener(evtName, (e) => {
          e.preventDefault();
          logoDropzone.classList.remove('border-champagne', 'bg-ivorySilk');
        });
      });
      logoDropzone.addEventListener('drop', (e) => {
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
          handleLogoFile(e.dataTransfer.files[0]);
        }
      });

      // Medallion Shape buttons
      document.querySelectorAll('.shape-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.medallionShape = btn.dataset.shape;
          document.querySelectorAll('.shape-btn').forEach((b) => {
            const active = b === btn;
            b.className = active
              ? 'shape-btn py-1.5 px-2.5 rounded-lg text-xs font-medium bg-white text-obsidian shadow-xs transition-all'
              : 'shape-btn py-1.5 px-2.5 rounded-lg text-xs font-medium text-gray-600 hover:text-obsidian transition-all';
          });
          updateStudio();
        });
      });

      // Logo Scale slider
      logoScaleRange.addEventListener('input', () => {
        state.logoScalePct = parseInt(logoScaleRange.value, 10);
        logoScaleLabel.textContent = `${state.logoScalePct}%`;
        updateStudio();
      });

      // Print Layout Preset buttons
      document.querySelectorAll('.preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.preset = btn.dataset.preset;
          document.querySelectorAll('.preset-btn').forEach((b) => {
            const active = b === btn;
            b.className = active
              ? 'preset-btn flex flex-col items-center justify-center p-2.5 rounded-xl border-2 border-obsidian bg-ivorySilk/70 text-obsidian transition-all'
              : 'preset-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-gray-200 hover:border-gray-300 bg-white text-gray-700 transition-all';
          });
          updateStudio();
        });
      });

      // Surface Tone buttons
      document.querySelectorAll('.surface-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.surface = btn.dataset.surface;
          document.querySelectorAll('.surface-btn').forEach((b) => {
            const active = b === btn;
            b.className = active
              ? 'surface-btn py-1.5 px-2.5 rounded-lg text-xs font-medium bg-white text-obsidian shadow-xs flex items-center justify-center gap-1.5 transition-all'
              : 'surface-btn py-1.5 px-2.5 rounded-lg text-xs font-medium text-gray-600 hover:text-obsidian flex items-center justify-center gap-1.5 transition-all';
          });
          updateStudio();
        });
      });

      // QR Module Geometry buttons
      document.querySelectorAll('.module-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.moduleStyle = btn.dataset.module;
          document.querySelectorAll('.module-btn').forEach((b) => {
            const active = b === btn;
            b.className = active
              ? 'module-btn py-1.5 px-2.5 rounded-lg text-xs font-medium bg-white text-obsidian shadow-xs transition-all'
              : 'module-btn py-1.5 px-2.5 rounded-lg text-xs font-medium text-gray-600 hover:text-obsidian transition-all';
          });
          updateStudio();
        });
      });

      // Toggles & Actions
      toggleWelcomeLine.addEventListener('change', () => {
        state.showWelcome = toggleWelcomeLine.checked;
        updateStudio();
      });

      togglePrintGuides.addEventListener('change', () => {
        state.showGuides = togglePrintGuides.checked;
        updateStudio();
      });

      retestDecodeBtn.addEventListener('click', () => {
        updateStudio();
        showFeedback('Re-scanned canvas pixels: Payload verified against original Google Maps URL.');
      });

      exportPngBtn.addEventListener('click', exportHighResPng);
      exportSvgBtn.addEventListener('click', exportVectorSvg);

      // Initialize once fonts and window are ready
      window.addEventListener('load', () => {
        buildQrMatrix();
        tryPreloadUploadedLogo();
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(updateStudio);
        } else {
          updateStudio();
        }
      });
    })();
  </script>
</body>
</html>
